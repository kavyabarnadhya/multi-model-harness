#!/usr/bin/env bash
# ask-gemini: one-shot, read-only task through Antigravity CLI (agy) on the Google AI Pro plan.
# (Gemini CLI no longer accepts AI Pro sign-in; agy is Google's replacement.)

HELPER=gemini
LIBDIR=$(dirname "$(readlink -f "$0")")
. "$LIBDIR/helper-lib.sh"
AGY="${AGY_BIN:-$(command -v agy || echo "$HOME/.gemini/bin/agy.exe")}"

usage() {
  usage_common
  echo "Models: review/code gemini-3.8-flash-high, read gemini-3.8-flash-medium (agy models lists more)"
}

parse_args "$@"
check_remembered
[ -n "$WORKTREE" ] && wt_setup
sanitize_env
[ -x "$AGY" ] || die_error "agy not found at $AGY"

# Effort is part of agy's model id. On a 350-line review Flash-low took 20 s, medium 7 min (63K thinking
# tokens) and high over 5 min with no answer (tested 5 Nov 2026), so low is the default.
[ -n "$EFFORT" ] && MODEL=${MODEL:-gemini-3.8-flash-$EFFORT}
MODEL=${MODEL:-gemini-3.8-flash-low}

new_run_dir
# agy streams no thinking events, so silence is normal for it; only the overall timeout applies.
IDLE_LIMIT=$TIMEOUT

# --mode plan keeps agy from editing files (accept-edits only inside a worktree);
# the per-run settings forbid paid G1 credits.
mode=plan
[ -n "$WORKTREE" ] && mode=accept-edits
# A denied tool ends a headless agy turn with no output, and agy likes to check its work with git, so
# read-only git commands are pre-allowed. Everything else that needs approval stays denied.
settings='{"useG1Credits":false,"permissions":{"allow":["command(git diff*)","command(git status*)","command(git log*)","command(git show*)"]}}'
args=(--output-format stream-json --model "$MODEL" --mode "$mode"
      --settings "$settings" --print-timeout "${TIMEOUT}s")
if [ ${#PROMPT} -gt "$HELPER_ARG_LIMIT" ]; then
  printf '%s' "$PROMPT" > "$work/prompt.md"
  args+=(--add-dir "$(cygpath -w "$work")")
  PROMPT="Your full instructions are in the file $(cygpath -w "$work/prompt.md"). Read that file and follow it."
fi

cd "$CWD" || die_error "cannot enter $CWD"
# agy's own --print-timeout ends the turn cleanly; the outer limit is only a backstop.
TIMEOUT=$((TIMEOUT + 30)) run_watched "$AGY" -p "$PROMPT" "${args[@]}"
[ "$RUN_END" = timeout ] && die_unavailable "timeout after $((TIMEOUT + 30))s"

# The final "result" event carries status, finished_reason, error and the response.
meta=$(node -e '
  const fs = require("fs");
  const [out, resp] = process.argv.slice(1);
  let r = null;
  for (const line of fs.readFileSync(out, "utf8").split("\n")) {
    try { const e = JSON.parse(line); if (e.event === "result") r = e.result; } catch {}
  }
  if (!r) { console.log("NORESULT"); process.exit(0); }
  fs.writeFileSync(resp, r.response || "");
  console.log([r.status || "", r.finished_reason || "", String(r.error || "").split("\n").join(" ")].join("\t"));
' "$(cygpath -w "$work/out")" "$(cygpath -w "$work/resp")")
IFS=$'\t' read -r status finished err <<< "$meta"
run_note "result: status=$status finished=$finished"

[ "$finished" = print_timeout ] && die_unavailable "timeout after ${TIMEOUT}s"
# agy 1.5 plan mode can stop after writing a plan.md and asking to "Proceed" instead of answering.
if grep -qiE 'click \*\*proceed\*\*|/brain/[^)]*plan\.md' "$work/resp" 2> /dev/null && [ -z "$WORKTREE" ]; then
  die_error "agy returned a plan instead of an answer; rephrase the request as a question"
fi
if [ "$status" = SUCCESS ] && [ -n "$(tr -d '[:space:]' < "$work/resp")" ]; then
  echo "[gemini: agy $MODEL]"
  cat "$work/resp"; echo
  [ -n "$WORKTREE" ] && { echo; wt_finish; }
  exit 0
fi
handle_failure "$err $(cat "$work/err")" "${err:-$(first_line "$work/err")}"
