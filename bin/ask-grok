#!/usr/bin/env bash
# ask-grok: one-shot, read-only task through Grok Build (grok) on the X subscription.

HELPER=grok
LIBDIR=$(dirname "$(readlink -f "$0")")
. "$LIBDIR/helper-lib.sh"
# Works even if the app was started before the installer added grok to PATH.
PATH="$HOME/.grok/bin:$PATH"

usage() {
  usage_common
  echo "Models: review/code grok-4.7, read grok-4.7-build-fast (grok models lists more)"
}

# Grok streams its reasoning slowly (a 350-line review with repo context takes 3-6 min), so it gets longer limits.
DEFAULT_TIMEOUT_OTHER=600
DEFAULT_TIMEOUT_CODE=900
parse_args "$@"
check_remembered
[ -n "$WORKTREE" ] && wt_setup
sanitize_env
command -v grok > /dev/null || die_error "grok not found in ~/.grok/bin or PATH"

# grok-4.5 answered a 350-line review in 3 min; grok-4.6, grok-4.7 and grok-4.7-build-fast were still
# thinking after 5-10 min (tested 5 Nov 2026), so 4.5 is the default for every task.
MODEL=${MODEL:-grok-4.5}

new_run_dir

# Read-only runs get only read tools. Not --permission-mode plan: in a real repo that starts grok's planning
# workflow (enter_plan_mode, ask_user_question, plan file), which a headless run never finishes.
# In a worktree, edits are allowed by a rule scoped to that folder: acceptEdits alone still blocks headless
# edits, and unscoped rules or --sandbox (not enforced on Windows) let grok write anywhere.
args=(--permission-mode default --no-plan --no-subagents --disable-web-search)
if [ -n "$WORKTREE" ]; then
  args+=(--tools read_file,grep,list_dir,search_replace,write --allow "Edit($(cygpath -m "$CWD")/**)")
else
  args+=(--tools read_file,grep,list_dir)
fi
# streaming-json emits a "thought" event every few words, which lets run_watched tell slow from stuck.
args+=(--output-format streaming-json -m "$MODEL" --cwd "$(cygpath -w "$CWD")")
[ -n "$EFFORT" ] && args+=(--reasoning-effort "$EFFORT")
if [ ${#PROMPT} -gt "$HELPER_ARG_LIMIT" ]; then
  printf '%s' "$PROMPT" > "$work/prompt.md"
  args+=(--prompt-file "$(cygpath -w "$work/prompt.md")")
else
  args+=(-p "$PROMPT")
fi

run_watched grok "${args[@]}"
[ "$RUN_END" = stuck ] && die_unavailable "stuck: no output for ${IDLE_LIMIT}s"
[ "$RUN_END" = timeout ] && die_unavailable "timeout after ${TIMEOUT}s"

# Join the "text" events into the answer; keep any "error" event's message.
err=$(node -e '
  const fs = require("fs");
  const [out, resp] = process.argv.slice(1);
  let text = "", err = "";
  for (const line of fs.readFileSync(out, "utf8").split("\n")) {
    let e; try { e = JSON.parse(line); } catch { continue; }
    if (e.type === "text" && typeof e.data === "string") text += e.data;
    if (e.type === "error") err = String(e.message || "");
  }
  fs.writeFileSync(resp, text);
  console.log(err.split("\n").join(" "));
' "$(cygpath -w "$work/out")" "$(cygpath -w "$work/resp")")

if [ "$RUN_RC" -eq 0 ] && [ -z "$err" ] && [ -n "$(tr -d '[:space:]' < "$work/resp")" ]; then
  echo "[grok: $MODEL${EFFORT:+, effort $EFFORT}]"
  cat "$work/resp"; echo
  [ -n "$WORKTREE" ] && { echo; wt_finish; }
  run_note "result: ok"
  exit 0
fi
run_note "result: failed rc=$RUN_RC"
# Classify only the error text: the event stream holds the model's thoughts, which can mention "quota" etc.
handle_failure "$err $(cat "$work/err")" "${err:-$(first_line "$work/err")}"
